# VyaparAI Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave empty or set to 'memory' to use auto-started in-memory MongoDB for zero-config local demo
MONGODB_URI=mongodb://localhost:27017/vyaparai
USE_MEMORY_DB=true

# Security
JWT_SECRET=vyaparai_super_secret_jwt_key_2025_dev_only
JWT_EXPIRES_IN=7d

# AI API Configuration (Optional: system falls back to rule-based agent simulator if omitted)
AI_API_KEY=
AI_PROVIDER=gemini # or openai / mock

# External Services (Dual-Mode: Real or Mock)
SUPPLIER_SERVICE_MODE=mock # mock or real
PAYMENT_SERVICE_MODE=mock # mock or real
GST_SERVICE_MODE=mock # mock or real
WHATSAPP_SERVICE_MODE=mock # mock or real

# WhatsApp Meta Cloud API (Used only if WHATSAPP_SERVICE_MODE=real)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
